{
  "name": "ChildProgress",
  "type": "object",
  "properties": {
    "child_name": {
      "type": "string",
      "description": "Nome da crian\u00e7a"
    },
    "letter": {
      "type": "string",
      "description": "Letra sendo praticada"
    },
    "stability": {
      "type": "number",
      "default": 0,
      "description": "Estabilidade FSRS da letra"
    },
    "difficulty": {
      "type": "number",
      "default": 0,
      "description": "Dificuldade FSRS da letra"
    },
    "interval": {
      "type": "number",
      "default": 0,
      "description": "Intervalo de revis\u00e3o em dias"
    },
    "repetitions": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de repeti\u00e7\u00f5es"
    },
    "next_review": {
      "type": "string",
      "format": "date-time",
      "description": "Data da pr\u00f3xima revis\u00e3o"
    },
    "total_attempts": {
      "type": "number",
      "default": 0
    },
    "correct_attempts": {
      "type": "number",
      "default": 0
    },
    "streak": {
      "type": "number",
      "default": 0
    },
    "last_grade": {
      "type": "number",
      "default": 0,
      "description": "\u00daltima nota (1=Repetir, 2=Dif\u00edcil, 3=Bom, 4=F\u00e1cil)"
    },
    "stars_earned": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "child_name",
    "letter"
  ]
}